# =============================================================================
# CivicResolve Web Frontend Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env in apps/web/ for local development.
#
# ARCHITECTURAL CLASSIFICATION & SECURITY RULES:
#
# 1. PUBLIC / CLIENT CONFIG
#    - VITE_SUPABASE_URL: Shared canonical Supabase endpoint.
#    - VITE_SUPABASE_ANON_KEY: Publishable client JWT key.
#    * Variables with VITE_ prefix are bundled directly into browser JavaScript.
#    * Safe for client-side storage because all authorization is enforced
#      server-side via PostgreSQL Row Level Security (RLS) policies.
#
# 2. OPTIONAL CLIENT CONFIG
#    - VITE_MAPBOX_ACCESS_TOKEN: Optional public vector tile access key.
#
# 3. SERVER-ONLY SECRETS (NEVER PLACE IN WEB / NEVER COMMIT)
#    - SUPABASE_SERVICE_ROLE_KEY: STRICTLY FORBIDDEN IN WEB
#    - DATABASE_PASSWORD: STRICTLY FORBIDDEN IN WEB
#    - GEMINI_API_KEY / GOOGLE_API_KEY: STRICTLY FORBIDDEN IN WEB CLIENT BUNDLE
#
# 4. CLIENT-EXPOSED CREDENTIAL WARNING
#    - Any credential prefixed with VITE_ or imported in frontend TypeScript
#      is readable in plaintext by anyone inspecting client assets.
# =============================================================================

# --- 1. PUBLIC / CLIENT CONFIG (Browser-bundled) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- 2. OPTIONAL CLIENT CONFIG ---
VITE_MAPBOX_ACCESS_TOKEN=

# =============================================================================
# --- 3. SERVER-ONLY SECRETS (NEVER EXPOSE VIA VITE_ / NEVER PUT IN CLIENT) ---
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY= (SERVER/ADMIN BACKEND ONLY - NEVER IN WEB2)
# DATABASE_PASSWORD= (DIRECT POSTGRES ONLY - NEVER IN WEB2)
# GEMINI_API_KEY= (SERVER-SIDE AI CALLS ONLY - NEVER IN WEB2 CLIENT)
