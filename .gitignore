# =============================================================================
# CivicResolve Enterprise Monorepo .gitignore
# =============================================================================

# --- Environment & Secrets (NEVER COMMIT SENSITIVE KEYS) ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.env
*.pem
*.key
*.cert
*.p12
*.jks
*.keystore

# --- Node / JavaScript / Web Build Outputs ---
node_modules/
dist/
build/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- Flutter / Dart Build & Cache ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/build/

# --- Android Build Artifacts ---
apps/mobile/android/app/debug
apps/mobile/android/app/profile
apps/mobile/android/app/release
apps/mobile/android/.gradle
apps/mobile/android/local.properties
**/android/**/build/
**/android/.gradle/
**/android/captures/
*.apk
*.aab

# --- iOS & macOS Build Artifacts ---
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/app.flx
apps/mobile/ios/Flutter/app.zip
apps/mobile/ios/Flutter/flutter_assets/
*.xcworkspace
*.xcuserdata
*.xcuserdatad

# --- Python AI & Classifier Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt

# --- IDEs & OS Metadata ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
