# =============================================================================
# CivicResolve Monorepo Master Environment Template (.env.example)
# =============================================================================
# Copy this file to .env in the respective workspace directories for local development:
# - Web: apps/web/.env
# - Mobile: apps/mobile/.env
#
# CANONICAL SHARED INFRASTRUCTURE:
# - Supabase Project: https://qxiivlfecbklwtnfsnjg.supabase.co
# - Database Auth: Supabase Auth (auth.users)
# - Security Model: PostgreSQL Row Level Security (RLS)
#
# =============================================================================
# SECURITY CLASSIFICATION MATRIX
# =============================================================================
#
# 1. PUBLIC / CLIENT CONFIG
#    - SUPABASE_URL / VITE_SUPABASE_URL
#    - SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#    * Safe for frontend/client bundle use under PostgreSQL RLS authorization.
#
# 2. OPTIONAL CLIENT CONFIG
#    - MAPBOX_ACCESS_TOKEN / VITE_MAPBOX_ACCESS_TOKEN
#
# 3. SERVER-ONLY SECRETS (NEVER IN CLIENT / NEVER COMMIT)
#    - SUPABASE_SERVICE_ROLE_KEY: Server-side admin tasks only.
#    - DATABASE_PASSWORD: Direct PostgreSQL connection only.
#    - GEMINI_API_KEY (Server-side): When AI requests route through backend.
#
# 4. CLIENT-EXPOSED CREDENTIAL WARNING
#    - GEMINI_API_KEY (Mobile client direct):
#      ⚠️ WARNING: Direct client-side Gemini calls in mobile embed this key in the
#      APK binary. It is client-exposed and not suitable for production secret storage.
#      Production hardening: Route image triage via server-side Edge Function.
# =============================================================================

# --- 1. PUBLIC / CLIENT CONFIG ---
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- 2. OPTIONAL CLIENT CONFIG ---
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# --- 3. CLIENT-EXPOSED CREDENTIAL (DEV/PROTOTYPE DIRECT CALLS ONLY) ---
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# =============================================================================
# --- 4. SERVER-ONLY SECRETS (NEVER EXPOSE TO CLIENTS) ---
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_PASSWORD=
